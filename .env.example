# Core runtime
NUTRIAI_DB_PATH=data/storage/nutrition.db
NUTRIAI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8081,http://127.0.0.1:8081
NUTRIAI_SECURE_COOKIE=false
NUTRIAI_LOG_REQUESTS=false

# Optional AI: disabled until explicitly configured. Choose a model supported by your account.
NUTRIAI_AI_PROVIDER=disabled
NUTRIAI_AI_MODEL=
NUTRIAI_VISION_MODEL=
NUTRIAI_AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Optional phone verification. Password recovery also works with one-time recovery codes.
NUTRIAI_SMS_PROVIDER=disabled
NUTRIAI_REQUIRE_VERIFIED_PHONE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Local USDA catalog works without credentials. Set usda for live FoodData Central search.
NUTRIAI_FOOD_PROVIDER=local
USDA_API_KEY=

# The only public mobile variable. Never prefix a provider key with EXPO_PUBLIC_.
EXPO_PUBLIC_API_URL=http://localhost:8000
