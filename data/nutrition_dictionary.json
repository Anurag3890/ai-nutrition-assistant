{
  "project": "AI Nutritionist Assistant",
  "version": "1.0.0",
  "description": "Unified data schema and dictionary for tracking nutrition, macros, micros, biometrics, and AI assistant interactions across app and website.",
  "data_models": {
    "user_profile": {
      "table": "users",
      "fields": {
        "id": "Unique user ID (UUID)",
        "username": "User handle",
        "email": "Contact and login email",
        "full_name": "Display name",
        "age": "Age in years (used for BMR calculation)",
        "sex": "Biological sex: 'male', 'female', 'other'",
        "height_cm": "Height in centimeters",
        "current_weight_kg": "Current body weight in kg",
        "target_weight_kg": "Goal body weight in kg",
        "activity_level": "'sedentary' (1.2x), 'lightly_active' (1.375x), 'moderately_active' (1.55x), 'very_active' (1.725x), 'extra_active' (1.9x)",
        "primary_goal": "'fat_loss', 'muscle_gain', 'maintenance', 'athletic_performance', 'metabolic_health', 'general_wellness'",
        "dietary_preference": "'omnivore', 'vegetarian', 'vegan', 'pescatarian', 'keto', 'paleo', 'mediterranean', 'low_carb'",
        "allergies": "Comma-separated or list of allergens (e.g. peanuts, shellfish, lactose, gluten)",
        "medical_conditions": "Health considerations (e.g. Type 2 Diabetes, Hypertension, PCOS, Celiac)",
        "daily_calorie_target": "Computed or customized daily kcal target",
        "daily_protein_target_g": "Daily protein goal in grams (typically 1.6g - 2.2g / kg)",
        "daily_carbs_target_g": "Daily carbohydrate goal in grams",
        "daily_fat_target_g": "Daily fat goal in grams",
        "daily_fiber_target_g": "Daily dietary fiber target in grams (default 25-35g)",
        "daily_water_target_ml": "Target hydration in milliliters (default 2500 - 3500ml)"
      }
    },
    "meal_log": {
      "table": "meal_logs",
      "fields": {
        "id": "Log entry UUID",
        "user_id": "Foreign key to users.id",
        "log_date": "Date of meal (YYYY-MM-DD)",
        "log_time": "Time of meal (HH:MM:SS)",
        "meal_type": "'breakfast', 'lunch', 'dinner', 'morning_snack', 'afternoon_snack', 'evening_snack', 'pre_workout', 'post_workout'",
        "food_name": "Name of dish or item",
        "quantity": "Serving amount (e.g. 1.0, 1.5, 2.0)",
        "serving_unit": "'plate', 'bowl', 'serving', 'g', 'oz', 'cup'",
        "calories": "Total energy in kcal",
        "protein_g": "Grams of protein",
        "carbs_g": "Total carbs in grams",
        "fat_g": "Total fat in grams",
        "fiber_g": "Dietary fiber in grams",
        "sugar_g": "Total sugars in grams",
        "sodium_mg": "Sodium in milligrams",
        "micronutrients": {
          "potassium_mg": "Potassium (mg)",
          "calcium_mg": "Calcium (mg)",
          "iron_mg": "Iron (mg)",
          "magnesium_mg": "Magnesium (mg)",
          "zinc_mg": "Zinc (mg)",
          "vitamin_a_mcg": "Vitamin A (mcg)",
          "vitamin_c_mg": "Vitamin C (mg)",
          "vitamin_d_iu": "Vitamin D (IU)",
          "vitamin_b12_mcg": "Vitamin B12 (mcg)"
        },
        "photo_url": "Image path / URL if captured via camera",
        "ai_analysis_summary": "AI Vision breakdown of the plate ingredients and portions",
        "user_notes": "Custom notes regarding hunger or cravings"
      }
    },
    "water_log": {
      "table": "water_logs",
      "fields": {
        "id": "UUID",
        "user_id": "Foreign key to users.id",
        "log_date": "Date (YYYY-MM-DD)",
        "log_time": "Time (HH:MM:SS)",
        "amount_ml": "Volume in milliliters (e.g. 250, 500, 750)",
        "beverage_type": "'water', 'herbal_tea', 'electrolyte_drink', 'black_coffee'"
      }
    },
    "biometric_log": {
      "table": "biometric_logs",
      "fields": {
        "id": "UUID",
        "user_id": "Foreign key to users.id",
        "log_date": "Date (YYYY-MM-DD)",
        "weight_kg": "Weigh-in in kilograms",
        "body_fat_pct": "Body fat percentage",
        "energy_level": "Rating scale 1-10",
        "sleep_hours": "Duration of sleep in hours",
        "sleep_quality": "Rating scale 1-10",
        "digestive_symptoms": "'normal', 'bloated', 'acid_reflux', 'cramping', 'constipated'"
      }
    },
    "ai_consultation": {
      "table": "ai_consultations",
      "fields": {
        "id": "UUID",
        "user_id": "Foreign key to users.id",
        "session_id": "Conversation thread ID",
        "sender": "'user' or 'assistant'",
        "message_text": "Content of prompt or response",
        "recommendation_type": "'meal_critique', 'recipe_suggestion', 'macro_adjustment', 'deficiency_warning', 'general_qna'"
      }
    }
  }
}
